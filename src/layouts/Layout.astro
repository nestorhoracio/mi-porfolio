---
// Layout.astro - Plantilla base del sitio
// Se usa en todas las páginas para mantener header y footer consistentes
const { title } = Astro.props;
import '../styles/global.css';
import '@fancyapps/ui/dist/fancybox/fancybox.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script>
  import { Fancybox } from '@fancyapps/ui';
  Fancybox.bind('[data-fancybox]');
</script>
    <title>{title}</title>
  </head>
  <body>

    <!-- HEADER: navegación principal -->
   <header>
  <div class="header-inner">
    <a href="/" class="logo">
      <img src="/images/nh_digital_space.png" alt="NH Digital Space" />
    </a>
    <button id="hamburger">☰</button>
    <nav id="nav-menu">
      <a href="/">Inicio</a>
      <a href="/sobre-mi">Sobre mí</a>
      <a href="/wordpress">WordPress</a>
      <a href="/astro-web">Astro Web</a>
      <a href="/contacto">Contacto</a>
      <a href="/paso-de-los-toros">Paso de los Toros</a>
    </nav>
  </div>
</header>

    <!-- SLOT: aquí se inyecta el contenido de cada página -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer>
  <div class="footer-redes">
    <a href="https://instagram.com/nh_digital_space/" target="_blank" aria-label="Instagram">
      <i class="fab fa-instagram"></i>
    </a>
    <a href="https://facebook.com/nhdigitalspace/" target="_blank" aria-label="Facebook">
      <i class="fab fa-facebook"></i>
    </a>
    <a href="https://wa.me/59899474094" target="_blank" aria-label="WhatsApp">
      <i class="fab fa-whatsapp"></i>
    </a>
  </div>
  <p>© 2026 Néstor Horacio — NH Digital Space</p>
</footer>
    <button id="theme-toggle">🌙</button>
<script>
  import '../scripts/app.js';
</script>
  </body>
</html>

