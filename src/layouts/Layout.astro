---
const { title, description = 'Diseñador web freelance desde Uruguay. Sitios WordPress y Astro rápidos, modernos y con propósito.' } = Astro.props;
import '../styles/global.css';
import '@fancyapps/ui/dist/fancybox/fancybox.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/nh_digital_space.png" />
    <script>
  import { Fancybox } from '@fancyapps/ui';
  Fancybox.bind('[data-fancybox]');
</script>
    <title>{title}</title>
  </head>
  <body>

    <!-- HEADER: navegación principal -->
   <header>
  <div class="header-inner">
    <a href="/" class="logo">
      <img src="/images/nh_digital_space.png" alt="NH Digital Space" />
    </a>
    <button id="hamburger" aria-label="Abrir menú de navegación" aria-expanded="false">☰</button>
    <nav id="nav-menu" aria-label="Navegación principal">
      <a href="/">Inicio</a>
      <a href="/sobre-mi">Sobre mí</a>
      <a href="/wordpress">WordPress</a>
      <a href="/astro-web">Astro Web</a>
      <a href="/contacto">Contacto</a>
      <a href="/paso-de-los-toros">Paso de los Toros</a>
    </nav>
  </div>
</header>

    <!-- SLOT: aquí se inyecta el contenido de cada página -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer>
  <div class="footer-redes">
    <a href="https://instagram.com/nh_digital_space/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
      <i class="fab fa-instagram"></i>
    </a>
    <a href="https://facebook.com/nhdigitalspace/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
      <i class="fab fa-facebook"></i>
    </a>
    <a href="https://wa.me/59899474094" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
      <i class="fab fa-whatsapp"></i>
    </a>
  </div>
  <p>© 2026 Néstor Horacio — NH Digital Space</p>
</footer>
    <button id="theme-toggle" aria-label="Cambiar tema claro/oscuro">🌙</button>
<script>
  import '../scripts/app.js';
</script>
  </body>
</html>

