---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Paso de los Toros | NH Digital Space" description="Paso de los Toros, ciudad natal de NH Digital Space. Clima en tiempo real, imágenes y descripción de esta ciudad de Tacuarembó, Uruguay.">

  <section class="ciudad-hero">
    <h1>Paso de los Toros</h1>
    <p class="subtitulo">Una ciudad con alma, a orillas del Río Negro — Tacuarembó, Uruguay</p>
  </section>

  <!-- CLIMA EN TIEMPO REAL -->
  <section class="clima-section">
    <div id="clima" class="clima-card">
      <p class="cargando">Cargando clima...</p>
    </div>
  </section>

  <!-- FOTOS DE UNSPLASH -->
  <section class="fotos-section">
    <h2>Uruguay en imágenes</h2>
    <div id="galeria-fotos" class="galeria-unsplash">
      <p class="cargando">Cargando imágenes...</p>
    </div>
  </section>

  <!-- TEXTO SOBRE LA CIUDAD -->
  <section class="ciudad-texto">
    <h2>Mi ciudad</h2>
    <p>Paso de los Toros es una ciudad ubicada en el departamento de Tacuarembó, a orillas del embalse del Río Negro. Es conocida por el Puente Paso de los Toros, uno de los más largos del Uruguay, y por la tranquilidad de su gente.</p>
    <p>Es mi ciudad natal — donde crecí, donde trabajo y desde donde ofrezco mis servicios al mundo digital.</p>
  </section>

</Layout>

<script>
const API_KEY = '4c4d852ac028cc8675918259a398c620';
const CIUDAD = 'Paso de los Toros,UY';
const UNSPLASH_KEY = 'H28t2y9smkqYPyeH6EKi83ni5FhNR72hW-wN47pONJM';

// CLIMA
async function cargarClima() {
  try {
    const res = await fetch(
      `https://api.openweathermap.org/data/2.5/weather?q=${CIUDAD}&appid=${API_KEY}&units=metric&lang=es`
    );
    const data = await res.json();
    
    document.getElementById('clima').innerHTML = `
      <div class="clima-info">
        <img src="https://openweathermap.org/img/wn/${data.weather[0].icon}@2x.png" alt="${data.weather[0].description}" />
        <div>
          <h3>${data.name}</h3>
          <p class="temp">${Math.round(data.main.temp)}°C</p>
          <p class="desc">${data.weather[0].description}</p>
          <p class="detalle">Humedad: ${data.main.humidity}% · Viento: ${Math.round(data.wind.speed * 3.6)} km/h</p>
        </div>
      </div>
    `;
  } catch {
    document.getElementById('clima').innerHTML = '<p>No se pudo cargar el clima.</p>';
  }
}

// FOTOS UNSPLASH
async function cargarFotos() {
  try {
    const res = await fetch(
      `https://api.unsplash.com/photos/random?query=uruguay+river&count=3&client_id=${UNSPLASH_KEY}`
    );
    const fotos = await res.json();
    
    document.getElementById('galeria-fotos').innerHTML = fotos.map(foto => `
      <a href="${foto.links.html}" target="_blank" rel="noopener noreferrer">
        <img src="${foto.urls.small}" alt="${foto.alt_description || 'Uruguay'}" />
      </a>
    `).join('');
  } catch {
    document.getElementById('galeria-fotos').innerHTML = '<p>No se pudieron cargar las imágenes.</p>';
  }
}

cargarClima();
cargarFotos();
</script>

<style>
  .ciudad-hero {
    text-align: center;
    padding: 4rem 1.5rem 2rem;
  }

  .ciudad-hero h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .subtitulo {
    color: var(--color-text-soft);
  }

  .clima-section {
    max-width: 500px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .clima-card {
    background: var(--color-surface);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
  }

  .clima-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .temp {
    font-size: 2.5rem;
    font-weight: bold;
    color: var(--color-primary);
  }

  .desc {
    text-transform: capitalize;
    color: var(--color-text-soft);
  }

  .detalle {
    font-size: 0.85rem;
    color: var(--color-text-soft);
    margin-top: 0.25rem;
  }

  .fotos-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .fotos-section h2 {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .galeria-unsplash {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .galeria-unsplash img {
    border-radius: 8px;
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .ciudad-texto {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .ciudad-texto h2 {
    margin-bottom: 1rem;
  }

  .ciudad-texto p {
    color: var(--color-text-soft);
    line-height: 1.7;
    margin-bottom: 1rem;
    text-align: center;
  }

  .cargando {
    color: var(--color-text-soft);
  }
</style>