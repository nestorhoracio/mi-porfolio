
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inicio | NH Digital Space" description="Diseñador web freelance desde Paso de los Toros, Uruguay. Especializado en WordPress y Astro. Sitios rápidos, modernos y con propósito.">

  <!-- SECCIÓN 1: HERO -->
  <section class="hero">
    <h1>Hola, soy Néstor Horacio</h1>
    <p class="subtitulo">Diseñador web freelance especializado en WordPress y Astro.</p>
    <p class="descripcion">Creo sitios rápidos, modernos y con propósito — desde Paso de los Toros, Uruguay, para el mundo.</p>
    <a href="/contacto" class="btn">Hablemos de tu proyecto</a>
  </section>

  <!-- SECCIÓN 2: PORTAFOLIO -->
  <section class="portfolio">
    <h2>Proyectos</h2>
    <div class="grid">
      <div class="card">
      <a href="/images/Jesuseselcamino1.jpg" data-fancybox="galeria-jec">
  <img src="/images/Jesuseselcamino1.jpg" alt="Captura de pantalla del sitio jesuseselcamino.uy — vista principal" />
</a>
<a href="/images/jesuseselcamino2.jpg" data-fancybox="galeria-jec">
  <img src="/images/jesuseselcamino2.jpg" alt="Captura de pantalla del sitio jesuseselcamino.uy — sección interior" />
</a>
<a href="/images/jesueselcamino3.jpg" data-fancybox="galeria-jec">
  <img src="/images/jesueselcamino3.jpg" alt="Captura de pantalla del sitio jesuseselcamino.uy — detalle de diseño" />
</a>
          <h3>jesuseselcamino.uy</h3>
        <p>Sitio institucional con design system propio y child theme personalizado en WordPress.</p>
      </div>
      <div class="card">
      <a href="/images/nestorhoracio1.jpg" data-fancybox="galeria-nh">
  <img src="/images/nestorhoracio1.jpg" alt="Captura de pantalla del portfolio nestorhoracio.com — vista principal" />
</a>
<a href="/images/nestorhoracio2.jpg" data-fancybox="galeria-nh">
  <img src="/images/nestorhoracio2.jpg" alt="Captura de pantalla del portfolio nestorhoracio.com — sección interior" />
</a>
<a href="/images/nestorhoracio3.jpg" data-fancybox="galeria-nh">
  <img src="/images/nestorhoracio3.jpg" alt="Captura de pantalla del portfolio nestorhoracio.com — detalle de diseño" />
</a>
        <h3>nestorhoracio.com</h3>
        <p>Portfolio personal construido con WordPress y Divi.</p>
      </div>
      <div class="card">
        <h3>NH Digital Space</h3>
        <p>Este mismo sitio — construido con Astro como ejercicio de aprendizaje y presentación.</p>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 3: LLAMADA A LA ACCIÓN -->
  <section class="cta">
    <h2>¿Necesitás un sitio web?</h2>
    <p>Contame tu proyecto y te respondo en 24 horas.</p>
    <a href="/contacto" class="btn">Ir a Contacto</a>
  </section>

</Layout>

